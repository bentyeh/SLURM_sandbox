#!/usr/bin/python3 -I
"""Stand-in for SLURM commands inside the confinement (bound over /usr/bin/sbatch, srun, scancel, squeue, ...).

It forwards the call, with its stdin, stdout and stderr, to the broker outside the confinement and exits with the
real command's exit status. It is self-contained because it runs from /usr/bin, away from the agent_slurm package.
"""
import json
import os
import signal
import socket
import struct
import sys

SOCKET = "/tmp/.agent-slurm.sock"
RELAYED = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT, signal.SIGUSR1, signal.SIGUSR2)


def send_msg(sock, obj, fds=()):
    data = json.dumps(obj).encode()
    header = struct.pack(">I", len(data))
    if fds:
        socket.send_fds(sock, [header], list(fds))
    else:
        sock.sendall(header)
    sock.sendall(data)


def recv_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            return None
        buf += chunk
    return buf


def recv_msg(sock):
    header = recv_exact(sock, 4)
    if header is None:
        return None
    data = recv_exact(sock, struct.unpack(">I", header)[0])
    return None if data is None else json.loads(data)


def main():
    name = os.path.basename(sys.argv[0])
    for fd in (0, 1, 2):   # the broker needs all three
        try:
            os.fstat(fd)
        except OSError:
            os.dup2(os.open(os.devnull, os.O_RDWR), fd)
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = "/"
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(SOCKET)
        send_msg(sock, {"argv": [name] + sys.argv[1:], "cwd": cwd, "env": dict(os.environ)}, [0, 1, 2])
    except OSError as e:
        print(f"{name} (confined): cannot reach the agent-slurm broker: {e}", file=sys.stderr)
        return 1

    def relay(signum, frame):
        try:
            send_msg(sock, {"signal": signum})
        except OSError:
            pass

    for s in RELAYED:
        signal.signal(s, relay)
    while True:
        try:
            msg = recv_msg(sock)
        except OSError:
            msg = None
        if msg is None:
            print(f"{name} (confined): the agent-slurm broker closed the connection", file=sys.stderr)
            return 1
        if "open" in msg:   # sbatch: the broker reads the job script through us, as we see the file system
            try:
                fd = os.open(msg["open"], os.O_RDONLY)
            except OSError as e:
                send_msg(sock, {"error": str(e)})
            else:
                send_msg(sock, {"ok": True}, [fd])
                os.close(fd)
        elif "exit" in msg:
            return msg["exit"]


if __name__ == "__main__":
    sys.exit(main())
