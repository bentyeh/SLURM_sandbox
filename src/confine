#!/usr/bin/python3 -I
# -I: isolated mode, implies -E, -P, and -s. 
# -E: Ignore all PYTHON* environment variables, e.g. PYTHONPATH and PYTHONHOME, that might be set.
# -P: Don’t prepend the potentially unsafe path sys._path0 (script’s directory) to sys.path.
# -s: Don’t add the user site-packages directory to sys.path.
"""Run a command confined: the file system is read-only except the project's approved folders, and SLURM is reachable
only through a broker that starts every new job and job step confined as well. See README.md.
"""
import os
import sys

sys.path.append(os.path.dirname(os.path.realpath(__file__)))   # -I leaves the script's folder off sys.path
from agent_slurm import launcher  # noqa: E402

sys.exit(launcher.main(sys.argv[1:]))
